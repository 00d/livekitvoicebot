# --- LiveKit Cloud project (Settings > Keys in your LiveKit Cloud dashboard) ---
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- LLM: Google Gemini ---
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# --- STT / TTS: routed through LiveKit Inference (billed via your LiveKit Cloud
#     project above — no separate Deepgram account/key needed) ---
DEEPGRAM_STT_MODEL=deepgram/nova-3
DEEPGRAM_TTS_VOICE=aura-2-luna-en

# --- Telephony: outbound SIP trunk (see setup_sip_trunk.py) ---
# Fill these in only to run setup_sip_trunk.py once:
TWILIO_TERMINATION_URI=
TWILIO_SIP_USERNAME=
TWILIO_SIP_PASSWORD=
TWILIO_CALLER_ID_NUMBER=
# Output of setup_sip_trunk.py goes here:
SIP_OUTBOUND_TRUNK_ID=

# --- Assessment target (fixed per the challenge instructions) ---
TARGET_PHONE_NUMBER=+18054398008

# --- Misc ---
AGENT_NAME=pgai-patient-caller
MAX_CALL_SECONDS=240
LOG_LEVEL=INFO
